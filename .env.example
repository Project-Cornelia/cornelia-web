# Project Cornelia — environment variables
# Copy to `.env.local` (local) or configure these in your hosting platform.

# --- Website ---------------------------------------------------------------
# Canonical site URL (no trailing slash).
NEXT_PUBLIC_SITE_URL="https://projectcornelia.org"

# Set to "true" to serve the /maintenance page site-wide.
NEXT_PUBLIC_MAINTENANCE_MODE=false

# --- Home page video -------------------------------------------------------
# A YouTube video ID or full URL. Leave empty to keep the "coming soon" state.
NEXT_PUBLIC_YOUTUBE_VIDEO_ID=

# --- Payload CMS -----------------------------------------------------------
# REQUIRED. Generate a strong random value, e.g. `openssl rand -base64 32`.
PAYLOAD_SECRET=

# --- Database (Turso / libsql) --------------------------------------------
TURSO_DB_URL=
AUTH_TOKEN=

# --- Cloudinary (media storage) -------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
